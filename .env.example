# Server-side only: read by the Vite dev server's /api proxy, and set as server-side
# environment variables on Vercel for api/proxy.js. Never prefix these with VITE_.
BACKEND_API_URL=https://api.jellyswarm.app
MASTER_API_KEY=ask-skipp-for-the-key

# Public (shipped to the browser): WalletConnect / Reown project ID for RainbowKit.
# Optional. Without it, browser-extension wallets still work.
VITE_WALLETCONNECT_PROJECT_ID=
