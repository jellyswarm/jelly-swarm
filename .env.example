# Local development only. Copy to .env; never commit .env.
# Set DATABASE_URL and REDIS_URL directly in your .env file.
# Generate a long random value and share it only with the API and trusted web proxy.
# Default offset ports prevent clashing with local Postgres/Redis instances.
DATABASE_URL=postgres://jelly:jelly@localhost:5433/jelly
REDIS_URL=redis://localhost:6380
MASTER_API_KEY=
OPEN_ROUTER_API_KEY=
