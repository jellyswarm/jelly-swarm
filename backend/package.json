{
  "name": "@jellyswarm/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "db:migrate": "bun -e \"import('./src/db/migrate.ts').then(({ migrate }) => migrate())\""
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "express": "5.3.0",
    "pg": "8.23.1",
    "viem": "2.58.6"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "typescript": "5.9.3"
  }
}
